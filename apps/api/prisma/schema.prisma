generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  LOBBY
  PLAYING
  FINISHED
  CANCELLED
}

enum GamePhase {
  LOBBY
  DISCUSSION
  REVEAL
  INTRO
  ROUND_REVEAL
  ROUND_PITCH
  ROUND_COMPLETE
  VOTING
  FINISHED
}

enum CardType {
  PROFESSION
  HEALTH
  CHARACTER
  SKILL
  BAGGAGE
  FACT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id              String   @id @default(cuid())
  telegramId      String   @unique
  telegramUsername String?
  firstName       String?
  lastName        String?
  nickname        String?
  photoUrl        String?
  phone           String?
  languageCode    String?
  isPremium       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hostedRooms     Room[]   @relation("HostUser")
  players         Player[]
  gameHistory     GameHistory[]

  @@index([phone])
}

enum GameOutcome {
  HOSTED
  WON
  ELIMINATED
  PLAYED
  CANCELLED
}

model GameHistory {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  playedAt        DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  disasterName    String?
  outcome         GameOutcome @default(PLAYED)
  roomCode        String?
  playerCount     Int?
  createdAt       DateTime    @default(now())

  @@index([userId, playedAt])
}

model Room {
  id            String      @id @default(cuid())
  code          String      @unique
  hostSessionId String
  hostUserId    String?
  hostUser      User?       @relation("HostUser", fields: [hostUserId], references: [id], onDelete: SetNull)
  status        RoomStatus  @default(LOBBY)
  winnerTarget  Int         @default(1)
  maxPlayers    Int         @default(10)
  isAdult       Boolean     @default(false)
  round         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  players       Player[]
  game          Game?
  votes         Vote[]

  @@index([hostUserId, createdAt])
}

model Player {
  id            String          @id @default(cuid())
  roomId        String
  room          Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sessionId     String
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  isHost        Boolean         @default(false)
  isAlive       Boolean         @default(true)
  seatOrder     Int
  joinedAt      DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  attributes    PlayerAttribute?
  votesCast     Vote[]          @relation("VotesCast")
  votesReceived Vote[]          @relation("VotesReceived")

  @@unique([roomId, sessionId])
  @@index([userId])
}

model Game {
  id                 String           @id @default(cuid())
  roomId             String           @unique
  room               Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  disasterId         String?
  disaster           Disaster?        @relation(fields: [disasterId], references: [id], onDelete: SetNull)
  currentSituationId String?
  currentSituation   Situation?       @relation(fields: [currentSituationId], references: [id], onDelete: SetNull)
  phase              GamePhase        @default(LOBBY)
  timerEndsAt        DateTime?
  startedAt          DateTime?
  roundNumber        Int              @default(0)
  currentTurnPlayerId String?
  lastRevealedPlayerId String?
  lastRevealedCardType CardType?
  lastEliminatedPlayerId String?
  tiebreakCandidateIds String[]       @default([])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  playerAttributes   PlayerAttribute[]
}

model PlayerAttribute {
  id         String   @id @default(cuid())
  playerId    String   @unique
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  profession String
  health     String
  character  String
  skill      String
  baggage    String
  fact       String
  revealed   CardType[] @default([])
}

model Vote {
  id            String   @id @default(cuid())
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roundNumber    Int
  voterPlayerId  String
  voterPlayer    Player   @relation("VotesCast", fields: [voterPlayerId], references: [id], onDelete: Cascade)
  targetPlayerId String
  targetPlayer   Player   @relation("VotesReceived", fields: [targetPlayerId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([roomId, roundNumber, voterPlayerId])
}

model Card {
  id        String   @id @default(cuid())
  type      CardType
  text      String
  isAdult   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, text])
  @@index([type, isAdult])
}

model Disaster {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  isAdult     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  games       Game[]
}

model Situation {
  id         String     @id @default(cuid())
  text       String     @unique
  difficulty Difficulty @default(MEDIUM)
  isAdult    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  games      Game[]
}
